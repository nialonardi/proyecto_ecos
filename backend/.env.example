# Clave para firmar los JWT. Cambiar en producción.
JWT_SECRET=change-me-ecos-secret

# Opcional: si se define, el Agente Conversacional usa Claude para generar
# las respuestas de conversación normal (fuera de los guardrails de seguridad).
# Sin esta variable, el sistema sigue funcionando con respuestas deterministas.
ANTHROPIC_API_KEY=

# Modelo a usar si hay API key configurada.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Por defecto la base de datos es SQLite en memoria (no escribe a disco, se resetea
# en cada reinicio del proceso). Para desarrollo local con persistencia entre
# reinicios, descomentar y apuntar a un archivo:
# ECOS_DB_URL=sqlite:///./ecos.db
